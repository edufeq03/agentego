# --- CONFIGURAÇÕES DE CORE (OPENAI) ---
OPENAI_API_KEY=sua_chave_aqui

# --- CONFIGURAÇÕES DE BANCO DE DADOS ---
DATABASE_URL=postgresql://user:pass@db:5432/atendimento
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=atendimento

# --- CONFIGURAÇÕES DE INTEGRAÇÃO (EVOLUTION API) ---
# URL completa do endpoint de envio de texto
EVOLUTION_URL=https://sua-evolution.com/message/sendText/instancia
EVOLUTION_API_KEY=sua_apikey_da_evolution

# --- CONFIGURAÇÕES DE SAAS / DASHBOARD ---
# URL base onde o seu bot-service está exposto (Importante para gerar os links de Webhook no Dashboard)
BASE_URL=https://api.seu-dominio.com
JWT_SECRET=mude_isso_para_algo_muito_seguro_em_producao

# --- CONFIGURAÇÕES DE NEGÓCIO ---
# Tempo de espera (debounce) para agrupar mensagens do mesmo usuário (segundos)
MESSAGE_BUFFER_SECONDS=4.0
