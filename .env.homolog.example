# ##############################################################################
# CONFIGURAÇÕES DE VARIÁVEIS DE AMBIENTE - AMBIENTE DE HOMOLOGAÇÃO (STAGING)
# ##############################################################################
# Copie este arquivo para .env.homolog no servidor/local de homologação.
# NÃO comite o arquivo .env.homolog real para o GitHub (este exemplo é seguro).
# ##############################################################################

# --- CONFIGURAÇÕES DE CORE (OPENAI - TESTES) ---
# Use chaves específicas ou monitore o consumo deste ambiente separadamente
OPENAI_API_KEY=sua_chave_openai_de_testes_aqui

# --- CONFIGURAÇÕES DE BANCO DE DADOS (ISOLADO - PORTA 5433) ---
# O host aponta para 'db-homolog' no contexto do docker-compose.homolog.yml
DATABASE_URL=postgresql://user_homolog:pass_homolog@db-homolog:5432/atendimento_homolog
POSTGRES_USER=user_homolog
POSTGRES_PASSWORD=pass_homolog
POSTGRES_DB=atendimento_homolog

# --- CONFIGURAÇÕES DE CACHE E REDIS (ISOLADO - PORTA 6380) ---
# O host aponta para 'redis-homolog'
REDIS_PASSWORD=mudar_senha_redis_homolog_aqui
REDIS_URL=redis://:mudar_senha_redis_homolog_aqui@redis-homolog:6379/0

# --- CONFIGURAÇÕES DE INTEGRAÇÃO (EVOLUTION API - INSTÂNCIA DE TESTE) ---
# IMPORTANTE: Use uma instância específica para homologação, nunca a de produção ativa!
EVOLUTION_URL=https://sua-evolution-homolog.com/message/sendText/instancia_teste
EVOLUTION_API_KEY=sua_apikey_da_evolution_homolog

# --- CONFIGURAÇÕES DE SAAS / DASHBOARD (HOMOLOGAÇÃO) ---
# URL pública do seu backend de homologação (ex: rodando na porta 8001 ou com subdomínio próprio)
BASE_URL=https://api-homolog.seu-dominio.com
JWT_SECRET=mude_isso_para_algo_muito_seguro_e_exclusivo_de_homologacao

# Token administrativo para onboarding de clientes em homologação
ADMIN_TOKEN=homolog123

# URL do painel administrativo de homologação
DASHBOARD_URL=https://homolog.agentego.com.br

# --- CONFIGURAÇÕES DE NEGÓCIO ---
MESSAGE_BUFFER_SECONDS=4.0
